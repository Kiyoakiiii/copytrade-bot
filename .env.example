# Required locally. Keep database credentials only in the ignored .env file.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=5.0
DATABASE_LOCK_TIMEOUT_SECONDS=2.0
LOW_LATENCY_SUBMIT_DATABASE_POOL_SIZE=8
LOW_LATENCY_SUBMIT_DATABASE_MAX_OVERFLOW=8
REDIS_URL=redis://redis:6379/0

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_HEDGE_MODE=true
BINANCE_TRADING_ENABLED=false
BINANCE_EXPECTED_LEVERAGE=10
BINANCE_EXPECTED_MARGIN_TYPE=ISOLATED
TRADING_ENABLED=false

# Execution venue
DEFAULT_PREFERRED_VENUE=HYPERLIQUID
ENABLE_HYPERLIQUID_EXECUTION=true
ENABLE_BINANCE_EXECUTION=false
ENABLE_BINANCE_FALLBACK=false

# Hyperliquid execution
HYPERLIQUID_EXECUTION_NETWORK=testnet
HYPERLIQUID_ACCOUNT_ADDRESS=
HYPERLIQUID_SIGNER_PRIVATE_KEY=
# Legacy alias. Prefer HYPERLIQUID_SIGNER_PRIVATE_KEY for new installs.
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_PRIVATE_KEY_FILE=
HYPERLIQUID_API_WALLET_ADDRESS=
HYPERLIQUID_VAULT_ADDRESS=
HYPERLIQUID_SUBACCOUNT_ADDRESS=
HYPERLIQUID_EXECUTION_SUBACCOUNT_ADDRESSES=
LOW_LATENCY_LEADER_ROUTE_MODE=DEFAULT
HYPERLIQUID_DEFAULT_LEVERAGE=50
HYPERLIQUID_DEFAULT_MARGIN_MODE=CROSS
HYPERLIQUID_MARKET_ORDER_SLIPPAGE_BPS=100
HYPERLIQUID_MIN_ORDER_VALUE_USD=10
HYPERLIQUID_TRADING_ENABLED=false
DURABLE_FILL_REPLAY_INTERVAL_SECONDS=0.1
# Empty durable scans back off, while live fills and retry deadlines still wake
# the watcher immediately.
DURABLE_FILL_REPLAY_IDLE_SECONDS=1.0
DURABLE_ORDER_RESUME_SCAN_SECONDS=1.0
DURABLE_FILL_RETRY_BASE_SECONDS=0.05
DURABLE_FILL_RETRY_MAX_SECONDS=5.0
DURABLE_FILL_REPLAY_BATCH_SIZE=1000
DURABLE_PIPELINE_STUCK_SECONDS=10.0
WATCHER_STATUS_REFRESH_SECONDS=2.0
MAX_PARALLEL_ORDER_SUBMITS_PER_MARKET=8
LEADER_FILL_RECONCILE_SECONDS=15.0
# Current names are a startup fallback. The watcher discovers and shares the
# authoritative perpDexs directory so future builder DEXes do not need a code
# change and sub-account workers do not pull a second copy.
ENABLED_HYPERLIQUID_DEXES=,xyz,flx,vntl,hyna,km,abcd,cash,para,mkts
ENABLE_ALL_HYPERLIQUID_PERP_DEXES=true
HYPERLIQUID_PERP_DEX_DISCOVERY_TIMEOUT_SECONDS=3
DEFAULT_HYPERLIQUID_DEX=
ENABLE_XYZ_DEX=true
XYZ_DEX_NAME=xyz
ALLOW_HIP3_MARKETS=true
LOW_LATENCY_REQUIRED_FOR_LIVE=true
ALLOW_POLL_FALLBACK_LIVE=false
# docker-compose runs the latency-critical watcher in its own process. Keep this
# true only for single-process deployments that do not use the watcher service.
EMBEDDED_LOW_LATENCY_WATCHER_ENABLED=true
MAX_FILL_DEBOUNCE_MS=0
LEADER_FILL_STARTUP_BACKFILL_SECONDS=60
PRICE_CACHE_STALE_MS=2000
PRICE_CACHE_POLL_SECONDS=1
MARKET_META_MISS_REFRESH_COOLDOWN_SECONDS=0.25
ALLOCATION_SYNC_POLL_SECONDS=1
ALLOCATION_POST_FILL_SNAPSHOT_LAG_GUARD_SECONDS=30
FOLLOWER_ACTIVE_POSITION_REFRESH_SECONDS=0.5
LOW_LATENCY_LEADER_REFRESH_SECONDS=2
ORDER_SUBMIT_TRANSPORT=websocket
HYPERLIQUID_WS_LEADER_SUBSCRIPTION_LIMIT=0
ACCOUNT_VALUE_MODE=auto
REQUIRE_CONFIRMED_ACCOUNT_ABSTRACTION_FOR_LIVE=true
ALLOW_UNIFIED_ACCOUNT_FOR_LIVE=true
ALLOW_PORTFOLIO_MARGIN_FOR_LIVE=false
UNIFIED_ACCOUNT_COLLATERAL_SOURCE=spot_or_portfolio
DEFAULT_COLLATERAL_TOKEN=USDC

APP_SECRET_KEY=
ENCRYPTION_MASTER_KEY=
ADMIN_EMAIL=operator@example.invalid
ADMIN_PASSWORD_BOOTSTRAP=
REQUIRE_TOTP=true
IP_ALLOWLIST=
COOKIE_SECURE=true

# Optional phone emergency control. Keep the token only in .env and allow only
# your numeric Telegram user ID(s), comma-separated. Private chats only.
TELEGRAM_CONTROL_ENABLED=false
TELEGRAM_CONTROL_BOT_TOKEN=
TELEGRAM_CONTROL_ALLOWED_USER_IDS=
TELEGRAM_CONTROL_POLL_TIMEOUT_SECONDS=25

HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info

DEFAULT_COPY_MULTIPLIER=0.1
GLOBAL_MAX_NOTIONAL=1000
GLOBAL_MAX_DAILY_LOSS=100
LEADER_STATE_STALE_SECONDS=10
ACCOUNT_STATE_STALE_SECONDS=2
ACCOUNT_STATE_POLL_SECONDS=5
ACCOUNT_VALUE_REFRESH_SECONDS=5
ACCOUNT_VALUE_MAX_STALE_SECONDS=30
ACCOUNT_VALUE_FULL_REFRESH_SECONDS=300
# Keep performance analytics out of the live API process. The isolated worker
# persists exchange cursors and only fetches new fills/funding every 15 minutes.
LEADER_PERFORMANCE_REFRESH_ENABLED=false
LEADER_PERFORMANCE_REFRESH_SECONDS=900
# Optional bootstrap seed. Used only when the database has zero leaders;
# production runtime uses database leaders managed from the frontend.
BOOTSTRAP_LEADER_ADDRESSES=
LOG_LEVEL=INFO

NEXT_PUBLIC_API_BASE=/api
